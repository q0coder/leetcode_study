class Solution {
     vector<int>ret;
public:
    vector<int> rightSideView(TreeNode* root) {
        TreeNode* node=root;
       int level=0;
       rightSideView(node,level);
        return ret;
    }
    void rightSideView(TreeNode* node,int level)
    {
        if(node==nullptr)
        {
            return;
        }
        if(level==ret.size())
        {
            ret.push_back(node->val);
        }
        rightSideView(node->right,level+1);

        rightSideView(node->left,level+1);
    }
};