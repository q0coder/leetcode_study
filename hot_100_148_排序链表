class Solution {
public:
    ListNode* sortList(ListNode* head) {
        if (head == nullptr) {
            return head;
        }
        
        // 计算链表总长度
        int length = 0;
        ListNode* node = head;
        while (node != nullptr) {
            length++;
            node = node->next;
        }
        
        // 设置虚拟头节点，方便后续处理边界情况
        ListNode* dummyHead = new ListNode(0, head);
        
        // 自底向上进行归并，步长从 1 开始每次翻倍 (1, 2, 4, 8...)
        for (int subLength = 1; subLength < length; subLength <<= 1) {
            ListNode* prev = dummyHead; 
            ListNode* curr = dummyHead->next;
            
            while (curr != nullptr) {
                // 截取第一段长度为 subLength 的链表
                ListNode* head1 = curr;
                for (int i = 1; i < subLength && curr->next != nullptr; i++) {
                    curr = curr->next;
                }
                
                // 断开第一段，并准备截取第二段
                ListNode* head2 = curr->next;
                curr->next = nullptr;
                curr = head2;
                
                // 截取第二段长度为 subLength 的链表（如果存在）
                for (int i = 1; i < subLength && curr != nullptr && curr->next != nullptr; i++) {
                    curr = curr->next;
                }
                
                // 记录下一轮需要处理的起始位置
                ListNode* next = nullptr;
                if (curr != nullptr) {
                    next = curr->next;
                    curr->next = nullptr;
                }
                
                // 合并这两段有序链表，并将结果接回主链表
                ListNode* merged = merge(head1, head2);
                prev->next = merged;
                
                // 移动 prev 指针到当前已合并链表的末尾
                while (prev->next != nullptr) {
                    prev = prev->next;
                }
                
                // 继续处理剩下的部分
                curr = next;
            }
        }
        return dummyHead->next;
    }

private:
    // 辅助函数：合并两个有序链表
    ListNode* merge(ListNode* head1, ListNode* head2) {
        ListNode* dummyHead = new ListNode(0);
        ListNode* temp = dummyHead;
        ListNode* temp1 = head1;
        ListNode* temp2 = head2;
        
        while (temp1 != nullptr && temp2 != nullptr) {
            if (temp1->val <= temp2->val) {
                temp->next = temp1;
                temp1 = temp1->next;
            } else {
                temp->next = temp2;
                temp2 = temp2->next;
            }
            temp = temp->next;
        }
        
        // 将剩余未遍历完的部分直接接在末尾
        if (temp1 != nullptr) {
            temp->next = temp1;
        } else if (temp2 != nullptr) {
            temp->next = temp2;
        }
        
        return dummyHead->next;
    }
};