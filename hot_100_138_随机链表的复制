class Solution {
public:
    Node* copyRandomList(Node* head) {
        if (head == nullptr) return nullptr;
        
        // 哈希表：用于存储 <原节点指针, 新节点指针> 的映射关系
        unordered_map<Node*, Node*> mp;
        
        // 第一步：构建基础链表与映射字典
        Node* cur = head;
        while (cur != nullptr) {
            mp[cur] = new Node(cur->val); // 克隆节点并存入哈希表
            cur = cur->next;
        }
        
        // 第二步：根据映射关系回填 next 和 random 指针
        cur = head;
        while (cur != nullptr) {
            mp[cur]->next = mp[cur->next];      // 处理 next 指针
            mp[cur]->random = mp[cur->random];  // 处理 random 指针
            cur = cur->next;
        }
        
        // 返回新链表的头节点
        return mp[head];
    }
};