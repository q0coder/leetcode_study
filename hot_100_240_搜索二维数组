class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
        if (matrix.empty() || matrix[0].empty()) return false;
        
        int m = matrix.size();
        int n = matrix[0].size();
        
        // 从右上角开始出发
        int row = 0;
        int col = n - 1;
        
        while (row < m && col >= 0) {
            if (matrix[row][col] == target) {
                return true;
            } else if (matrix[row][col] > target) {
                // 当前值太大，目标值只能在左边，列数减一
                col--;
            } else {
                // 当前值太小，目标值只能在下面，行数加一
                row++;
            }
        }
        
        return false;
    }
};