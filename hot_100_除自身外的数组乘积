class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        vector<int>vec(nums.size(),1);
        int rightv=1;
        for(int i=1;i<nums.size();++i)
        {
            vec[i]=vec[i-1]*nums[i-1];
        }
        for(int i=nums.size()-1;i>=0;--i)
        {
            
            vec[i]*=rightv;
            rightv*=nums[i];
        }
        return vec;
    }
};